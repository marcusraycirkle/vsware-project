# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/schoolware?retryWrites=true&w=majority

# JWT Secret (Generate a strong random string)
JWT_SECRET=change-this-to-a-long-random-string-min-32-characters

# Environment
NODE_ENV=production

# Port
PORT=5000

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your MongoDB Atlas connection string
# 3. Generate a secure JWT_SECRET: openssl rand -base64 32
# 4. Never commit .env to git
