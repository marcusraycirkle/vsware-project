{
  "name": "compmis",
  "version": "1.0.0",
  "description": "CompMIS - Comprehensive Management Information System for St Patrick's Comprehensive School, Shannon, Co. Clare",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "npm start --prefix client",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\"",
    "build": "npm install && cd client && npm install && npm run build"
  },
  "keywords": ["school", "management", "education", "student", "information", "system"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-validator": "^7.0.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "socket.io": "^4.7.2",
    "moment": "^2.29.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "concurrently": "^8.2.2"
  }
}
