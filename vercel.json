{
  "version": 2,
  "name": "vsware-project",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*\\.(js|css))",
      "dest": "frontend/$1",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache",
        "Expires": "0"
      }
    },
    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp3|wav|mp4))",
      "dest": "frontend/$1"
    },
    {
      "src": "/frontend/privacy-policy.html",
      "dest": "frontend/privacy-policy.html"
    },
    {
      "src": "/frontend/terms-of-service.html",
      "dest": "frontend/terms-of-service.html"
    },
    {
      "src": "/selector",
      "dest": "server.js"
    },
    {
      "src": "/login",
      "dest": "server.js"
    },
    {
      "src": "/shannoncomp/login",
      "dest": "server.js"
    },
    {
      "src": "/shannoncomp/enrolment",
      "dest": "server.js"
    },
    {
      "src": "/shannoncomp/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/home",
      "dest": "server.js"
    },
    {
      "src": "/",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "regions": ["iad1"]
}
